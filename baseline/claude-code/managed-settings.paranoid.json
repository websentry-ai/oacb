{
  "$schema": "https://raw.githubusercontent.com/websentry-ai/oacb/main/schemas/managed-settings-0.1.json",
  "_oacb": {
    "name": "OACB Claude Code Auto Mode Profile",
    "version": "0.1.1",
    "tier": "paranoid",
    "repo": "https://github.com/websentry-ai/oacb",
    "supportedClaudeCodeRange": ">=2.1.83 <3.0.0",
    "description": "Paranoid tier: autonomous mode disabled entirely. Agent operates as review-only. For FedRAMP, classified, or highly regulated environments. Not intended for fleet-wide deployment — apply per-project."
  },

  "permissions": {
    "defaultMode": "plan",

    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf ${HOME}*)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -fr /*)",
      "Bash(rm -fr ~*)",
      "Bash(rm -fr ${HOME}*)",
      "Bash(rm -fr $HOME*)",
      "Bash(rm -Rf /*)",
      "Bash(rm -Rf ~*)",
      "Bash(rm -Rf ${HOME}*)",
      "Bash(rm -Rf $HOME*)",

      "Bash(dd *)",

      "Bash(terraform destroy *)",
      "Bash(terraform apply -auto-approve*)",
      "Bash(terraform state rm *)",

      "Bash(drizzle-kit push --force*)",
      "Bash(prisma migrate reset *)",
      "Bash(alembic downgrade *)",

      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *main*)",
      "Bash(git push --force-with-lease *master*)",
      "Bash(git push --force-with-lease *release/*)",
      "Bash(git reset --hard*)",

      "Bash(history *)",
      "Bash(eval *)",
      "Bash(exec *)",

      "Bash(history)",
      "Bash(eval)",
      "Bash(exec)",

      "Bash(find / -delete*)",
      "Bash(find ~ -delete*)",

      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/**)",
      "Read(**/.netrc)",
      "Read(**/.config/**)",
      "Read(**/.kube/**)",
      "Read(**/.docker/**)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(**/.m2/**)",
      "Read(**/.gnupg/**)",
      "Read(/etc/**)",
      "Read(/var/**)",
      "Read(~/Library/**)",
      "Read(~/.zsh_history)",
      "Read(~/.bash_history)",

      "Write(**/.claude/**)",
      "Write(**/.cursor/**)",
      "Write(**/.codex/**)",
      "Write(**/CLAUDE.md)",
      "Write(**/AGENTS.md)",
      "Write(/etc/**)",
      "Write(/var/**)",
      "Write(~/.ssh/**)",
      "Write(~/Library/**)",
      "Edit(**/.claude/**)",
      "Edit(**/.cursor/**)",
      "Edit(**/.codex/**)",
      "Edit(**/CLAUDE.md)",
      "Edit(**/AGENTS.md)",
      "Edit(/etc/**)",
      "Edit(/var/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/Library/**)"
    ],

    "ask": [
      "Bash(curl *)",
      "Bash(wget *)",

      "Bash(rm *)",
      "Bash(mv * /*)",

      "Bash(terraform *)",
      "Bash(drizzle-kit *)",
      "Bash(prisma *)",
      "Bash(alembic *)",

      "Bash(git push *)",
      "Bash(git rebase *)",

      "Bash(find * -delete*)",
      "Bash(find * -exec *)",

      "Bash(sudo *)",
      "Bash(doas *)",
      "Bash(su *)",

      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(mount *)",
      "Bash(umount *)",

      "Bash(iptables *)",
      "Bash(nft *)",
      "Bash(pfctl *)",

      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",

      "Bash(ssh-keygen *)",
      "Bash(gpg *)",
      "Bash(openssl *)",

      "Bash(docker push *)",
      "Bash(docker run *)",
      "Bash(docker exec *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl delete *)",
      "Bash(kubectl exec *)",

      "Bash(aws *)",
      "Bash(gcloud *)",
      "Bash(az *)",

      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(find *)",

      "Read(./.env*)",
      "Read(./config/**)",
      "Read(./secrets/**)",

      "Write(**/**)",
      "Edit(**/**)",

      "WebFetch(domain:*)"
    ],

    "allow": [
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(echo *)",

      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git show *)",

      "Read(./src/**)",
      "Read(./docs/**)",
      "Read(./README*)",
      "Read(./package.json)",
      "Read(./Cargo.toml)",
      "Read(./pyproject.toml)",
      "Read(./go.mod)"
    ],

    "allowManagedPermissionRulesOnly": true,
    "allowManagedHooksOnly": true,
    "allowManagedMcpServersOnly": true,
    "disableAutoMode": "disable",
    "disableBypassPermissionsMode": "disable"
  },

  "autoMode": {
    "environment": [
      "$defaults",
      "PARANOID TIER: auto mode is disabled. This config is for human-in-loop review only."
    ],
    "soft_deny": [
      "$defaults",
      "Never run terraform destroy, terraform apply -auto-approve, prisma migrate reset, alembic downgrade, or drizzle-kit push --force under any circumstance",
      "Never force-push to any branch",
      "Never run git reset --hard",
      "Never commit .env files or files containing API keys",
      "Never read SSH keys, AWS credentials, shell history, or any credential files",
      "Never modify .claude/, .cursor/, .codex/, or agent config directories",
      "Before every state-changing action: state exactly what the command does, what it will affect, and why it is necessary — then request explicit user approval before executing"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/share/oacb/hooks/oacb-enforce.sh",
            "timeout": 5000,
            "env": { "OACB_TIER": "paranoid" }
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/share/oacb/hooks/oacb-mcp-guard.sh",
            "timeout": 3000,
            "env": { "OACB_TIER": "paranoid" }
          }
        ]
      },
      {
        "matcher": "Write|Edit|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/share/oacb/hooks/oacb-enforce.sh",
            "timeout": 3000,
            "env": { "OACB_TIER": "paranoid" }
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/share/oacb/hooks/oacb-prompt-guard.sh",
            "timeout": 3000,
            "env": { "OACB_TIER": "paranoid" }
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/share/oacb/hooks/oacb-post-tool.sh",
            "timeout": 3000,
            "async": true,
            "env": { "OACB_TIER": "paranoid" }
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/share/oacb/hooks/oacb-post-tool.sh",
            "timeout": 3000,
            "async": true,
            "env": { "OACB_TIER": "paranoid" }
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/share/oacb/hooks/oacb-config-audit.sh",
            "timeout": 3000,
            "env": { "OACB_TIER": "paranoid" }
          }
        ]
      }
    ]
  }
}
